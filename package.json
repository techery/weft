{
  "name": "weft-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Weft: durable, journaled, schema-validated multi-agent coding workflows in TypeScript.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @techery/weft-ui typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "sync:meta": "node scripts/sync-package-meta.mjs",
    "verify:packing": "node scripts/verify-packing.mjs",
    "verify:examples": "node scripts/check-example-coverage.mjs",
    "version:set": "node scripts/set-version.mjs",
    "verify:install": "node scripts/verify-install.mjs",
    "dev:ui": "pnpm --filter @techery/weft-ui dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11",
    "tsx": "^4.23.12",
    "@techery/weft-core": "workspace:*",
    "@techery/weft-provider-mock": "workspace:*",
    "@techery/weft-sdk": "workspace:*",
    "@techery/weft-stdlib": "workspace:*",
    "@techery/weft-testing": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techery/weft.git"
  },
  "homepage": "https://github.com/techery/weft#readme",
  "bugs": {
    "url": "https://github.com/techery/weft/issues"
  },
  "author": "Techery"
}
