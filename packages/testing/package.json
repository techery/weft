{
  "name": "@techery/weft-testing",
  "version": "0.1.0",
  "description": "runWorkflow harness, mock fixtures, journal assertions, conformance suites.",
  "keywords": [
    "weft",
    "workflow",
    "agents",
    "ai",
    "durable",
    "typescript"
  ],
  "license": "MIT",
  "author": "Techery",
  "homepage": "https://github.com/techery/weft/tree/main/packages/testing#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techery/weft.git",
    "directory": "packages/testing"
  },
  "bugs": {
    "url": "https://github.com/techery/weft/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./conformance": {
      "types": "./src/conformance.ts",
      "default": "./src/conformance.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./conformance": {
        "types": "./dist/conformance.d.ts",
        "default": "./dist/conformance.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@techery/weft-core": "workspace:*",
    "@techery/weft-host": "workspace:*",
    "@techery/weft-sdk": "workspace:*",
    "@techery/weft-provider-mock": "workspace:*",
    "@techery/weft-store-fs": "workspace:*",
    "picomatch": "^4.0.5"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.2"
  },
  "peerDependencies": {
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
