{
  "name": "@techery/weft-stdlib",
  "version": "0.1.0",
  "description": "Typed workflow patterns: adversarialVerify, judgePanel, loopUntilDry, …",
  "keywords": [
    "weft",
    "workflow",
    "agents",
    "ai",
    "durable",
    "typescript"
  ],
  "license": "MIT",
  "author": "Techery",
  "homepage": "https://github.com/techery/weft/tree/main/packages/stdlib#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techery/weft.git",
    "directory": "packages/stdlib"
  },
  "bugs": {
    "url": "https://github.com/techery/weft/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@techery/weft-sdk": "workspace:*"
  },
  "devDependencies": {
    "@techery/weft-core": "workspace:*",
    "@techery/weft-provider-mock": "workspace:*"
  }
}
