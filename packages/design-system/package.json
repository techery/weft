{
  "name": "@techery/weft-design-system",
  "version": "0.1.0",
  "description": "Reusable React primitives and visual foundations for Weft workflow UIs.",
  "keywords": [
    "weft",
    "workflow",
    "react",
    "design-system"
  ],
  "license": "MIT",
  "author": "Techery",
  "homepage": "https://github.com/techery/weft/tree/main/packages/design-system#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techery/weft.git",
    "directory": "packages/design-system"
  },
  "bugs": {
    "url": "https://github.com/techery/weft/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles": {
      "types": "./src/styles.ts",
      "default": "./src/styles.ts"
    },
    "./icons": {
      "types": "./src/icons.ts",
      "default": "./src/icons.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles": {
        "types": "./dist/styles.d.ts",
        "default": "./dist/styles.js"
      },
      "./icons": {
        "types": "./dist/icons.d.ts",
        "default": "./dist/icons.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "react": "^19.2.8"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10"
  }
}
