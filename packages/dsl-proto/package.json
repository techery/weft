{
  "name": "@techery/weft-dsl-proto",
  "version": "0.1.0",
  "description": "Type-only prototype of the intended Weft context DSL.",
  "keywords": [
    "weft",
    "workflow",
    "dsl",
    "prototype",
    "typescript"
  ],
  "license": "MIT",
  "author": "Techery",
  "homepage": "https://github.com/techery/weft/tree/main/packages/dsl-proto#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techery/weft.git",
    "directory": "packages/dsl-proto"
  },
  "bugs": {
    "url": "https://github.com/techery/weft/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "PROTOTYPE.md",
    "DESIGN-ROUNDS.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:docs": "node scripts/check-declaration-docs.mjs",
    "clean": "rm -rf dist",
    "prepack": "pnpm run clean && pnpm run build && pnpm run typecheck",
    "typecheck": "pnpm run check:docs && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
