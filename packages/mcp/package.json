{
  "name": "@techery/weft-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing weft.run/wait/answer/resume/list/report/types.",
  "keywords": [
    "weft",
    "workflow",
    "agents",
    "ai",
    "durable",
    "typescript"
  ],
  "license": "MIT",
  "author": "Techery",
  "homepage": "https://github.com/techery/weft/tree/main/packages/mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techery/weft.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/techery/weft/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "bin",
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@techery/weft-host": "workspace:*",
    "@techery/weft-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "bin": {
    "weft-mcp": "./bin/weft-mcp.js"
  },
  "devDependencies": {
    "tsx": "^4.23.12"
  }
}
