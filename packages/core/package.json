{
  "name": "@techery/weft-core",
  "version": "0.1.0",
  "description": "Weft engine: scheduler, replayer, journal model, budget, HITL broker, projections.",
  "keywords": [
    "weft",
    "workflow",
    "agents",
    "ai",
    "durable",
    "typescript"
  ],
  "license": "MIT",
  "author": "Techery",
  "homepage": "https://github.com/techery/weft/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techery/weft.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/techery/weft/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@techery/weft-sdk": "workspace:*",
    "@techery/weft-git": "workspace:*",
    "@techery/weft-isolation": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "execa": "^10.0.1",
    "tinyglobby": "^0.2.17",
    "picomatch": "^4.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.2",
    "@techery/weft-provider-mock": "workspace:*"
  }
}
